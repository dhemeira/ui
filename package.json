{
  "name": "@dhemeira/ui",
  "version": "0.1.1",
  "description": "Dependency-free React UI primitives built on plain HTML elements and Tailwind.",
  "type": "module",
  "license": "MIT",
  "author": "Peter Lakics",
  "keywords": ["react", "ui", "components", "tailwind", "primitives"],
  "homepage": "https://github.com/dhemeira/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhemeira/ui.git"
  },
  "bugs": {
    "url": "https://github.com/dhemeira/ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./src/*": "./src/*"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "dev": "node scripts/dev.mjs",
    "dev:js": "vite build --watch",
    "dev:types": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
